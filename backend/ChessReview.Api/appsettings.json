{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Quotas": {
    "AnalysesPerDay": 20
  },
  "RateLimiting": {
    "Registrations": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    },
    "Requests": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Gemini": {
    "Model": "gemini-3.5-flash"
  },
  "ExplanationWorker": {
    "Enabled": true,
    "IdleSeconds": 5,
    "SecondsBetweenRequests": 7,
    "SecondsAfterFailure": 60
  }
}
