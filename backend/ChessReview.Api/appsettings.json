{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Quotas": {
    "AnalysesPerDay": 20
  },
  "RateLimiting": {
    "Registrations": {
      "PermitLimit": 5,
      "WindowSeconds": 3600
    },
    "Requests": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
