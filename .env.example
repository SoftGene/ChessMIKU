# Copy to .env and fill in. .env stays out of git.

# SQL Server "sa" password: at least 8 characters with upper and lower case letters, digits and
# symbols. No ';' or '$': the password goes into a connection string and through docker compose.
MSSQL_SA_PASSWORD=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey). The API uses it to
# write explanations; it never leaves the server.
GEMINI_API_KEY=

# Only on the server, for docker-compose.tunnel.yml: the token of the Cloudflare Tunnel
# (Zero Trust -> Networks -> Tunnels -> the tunnel -> install connector with Docker).
CLOUDFLARE_TUNNEL_TOKEN=
